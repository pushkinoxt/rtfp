---
// src/layouts/Layout.astro
// The single shared layout for every page on RTFP. Owns the design system:
// width, typography, header, nav, footer, base styles. Pages slot their
// content into <slot/> and pass page-specific metadata via Astro.props.

import Analytics from "@vercel/analytics/astro";

const { title, description } = Astro.props;

const PUBLIC_URL = "https://rtfp.io";
const canonicalURL = new URL(Astro.url.pathname, PUBLIC_URL).href;
const ogImage = `${PUBLIC_URL}/og.png`;

// Active-section detection for the nav. The "Data" menu groups several routes,
// so its parent lights up when the current path is any of them.
const path = Astro.url.pathname;
const isActive = (p) => path === p || path.startsWith(p + "/");
const DATA_ROUTES = ["/data", "/patterns", "/explore", "/sources", "/api"];
const inDataSection = DATA_ROUTES.some((p) => isActive(p));
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />  <!-- REMOVE before public launch -->
    <title>{title}</title>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="RTFP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RTFP, read the fine print" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Analytics />

    <style is:global>
      :root {
        --bg: #fafaf9;
        --ink: #1c1917;
        --ink-dim: #57534e;
        --ink-faint: #78716c;
        --border: #e7e5e4;
        --code-bg: #f0eee9;
        --content-width: 56rem;
        --content-width-wide: 64rem;
      }

      * { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.6;
      }

      .page-header,
      .page-main,
      .page-footer {
        max-width: var(--content-width);
        margin: 0 auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }

      /* The home page benefits from a slightly wider layout to accommodate
         the two-column findings grid. Pages opt in via the .wide class. */
      .wide .page-header,
      .wide .page-main,
      .wide .page-footer {
        max-width: var(--content-width-wide);
      }

      .page-header {
        padding-top: 3rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
      }
      .page-header h1 {
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .page-header h1 .wordmark {
        color: inherit;
        text-decoration: none;
      }
      .page-header h1 .wordmark:hover,
      .page-header h1 .wordmark:focus { color: var(--ink); text-decoration: none; }
      .page-header nav {
        margin-top: 1rem;
        display: flex;
        gap: 1.5rem;
        font-size: 0.95rem;
        color: var(--ink-dim);
      }
      .page-header nav a {
        color: inherit;
        text-decoration: none;
      }
      .page-header nav a:hover { color: var(--ink); }
      .page-header nav a[aria-current="page"] {
        color: var(--ink);
        font-weight: 500;
      }

      /* Dropdown nav items (Data, Fine Print): the label is a link to the hub,
         and a separate caret toggles the menu (opened by the script below). */
      .nav-dropdown { position: relative; display: inline-flex; align-items: center; gap: 0.2rem; }
      .nav-dropdown.is-active > .nav-dropdown-label { color: var(--ink); font-weight: 500; }
      .nav-caret {
        appearance: none;
        background: none;
        border: 0;
        margin: 0;
        padding: 0.15rem 0.1rem;
        cursor: pointer;
        color: inherit;
        display: inline-flex;
        align-items: center;
      }
      .nav-caret::after {
        content: "";
        width: 0.4rem;
        height: 0.4rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translateY(-2px) rotate(45deg);
        transition: transform 0.15s ease;
      }
      .nav-caret[aria-expanded="true"]::after { transform: translateY(1px) rotate(-135deg); }
      .nav-caret:hover { color: var(--ink); }
      .nav-menu {
        display: none;
        position: absolute;
        top: calc(100% + 0.6rem);
        left: 0;
        z-index: 20;
        flex-direction: column;
        gap: 0.1rem;
        min-width: 10rem;
        padding: 0.4rem;
        background: white;
        border: 1px solid var(--border);
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
      }
      .nav-menu.open { display: flex; }
      .nav-menu a {
        padding: 0.4rem 0.6rem;
        border-radius: 5px;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .nav-menu a:hover { background: var(--code-bg); }
      .nav-menu a[aria-current="page"] { color: var(--ink); font-weight: 500; }

      .page-main {
        padding-top: 3rem;
        padding-bottom: 3rem;
      }
      .page-main h2 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 1rem;
      }
      .page-main h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 2.5rem 0 0.75rem;
      }
      .page-main h3:first-of-type { margin-top: 1.5rem; }
      .page-main p {
        font-size: 1rem;
        color: var(--ink-dim);
        margin: 0 0 1rem;
      }
      .page-main a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--ink-faint);
        text-underline-offset: 3px;
      }
      .page-main a:hover { text-decoration-color: var(--ink); }

      .page-main code,
      .page-main pre {
        font-family: ui-monospace, "SF Mono", Menlo, Monaco, "Cascadia Code", monospace;
      }
      .page-main code {
        font-size: 0.9em;
        background: var(--code-bg);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
      }
      .page-main pre {
        background: var(--code-bg);
        padding: 0.75rem 1rem;
        border-radius: 4px;
        overflow-x: auto;
        font-size: 0.85em;
        line-height: 1.4;
      }
      .page-main pre code { background: none; padding: 0; }

      .page-footer {
        padding-top: 2rem;
        padding-bottom: 4rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: var(--ink-faint);
      }
      .page-footer p { margin: 0 0 0.5rem; }
      .page-footer a { color: var(--ink-faint); }
      .page-footer .footer-legal {
        margin-top: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px solid var(--border);
        font-size: 0.8rem;
      }
    </style>
  </head>

  <body class={Astro.props.wide ? "wide" : ""}>
    <header class="page-header">
      <h1><a href="/" class="wordmark">RTFP</a></h1>
      <nav>
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
        <a href="/platforms" aria-current={isActive("/platforms") ? "page" : undefined}>Platforms</a>
        <div class:list={["nav-dropdown", { "is-active": inDataSection }]}>
          <a href="/data" class="nav-dropdown-label" aria-current={path === "/data" ? "page" : undefined}>Data</a>
          <button type="button" class="nav-caret" aria-haspopup="true" aria-expanded="false" aria-label="Open Data menu"></button>
          <div class="nav-menu" role="menu">
            <a href="/patterns" role="menuitem" aria-current={isActive("/patterns") ? "page" : undefined}>Patterns</a>
            <a href="/explore" role="menuitem" aria-current={isActive("/explore") ? "page" : undefined}>Explore</a>
            <a href="/sources" role="menuitem" aria-current={isActive("/sources") ? "page" : undefined}>Sources</a>
            <a href="/api" role="menuitem" aria-current={isActive("/api") ? "page" : undefined}>API</a>
          </div>
        </div>
        <div class:list={["nav-dropdown", { "is-active": isActive("/fine-print") }]}>
          <a href="/fine-print" class="nav-dropdown-label" aria-current={path === "/fine-print" ? "page" : undefined}>Fine Print</a>
          <button type="button" class="nav-caret" aria-haspopup="true" aria-expanded="false" aria-label="Open Fine Print menu"></button>
          <div class="nav-menu" role="menu">
            <a href="/fine-print/method" role="menuitem" aria-current={isActive("/fine-print/method") ? "page" : undefined}>Method</a>
            <a href="/fine-print/footnotes" role="menuitem" aria-current={isActive("/fine-print/footnotes") ? "page" : undefined}>Footnotes</a>
          </div>
        </div>
        <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>
      </nav>
    </header>

    <main class="page-main">
      <slot />
    </main>

    <footer class="page-footer">
      <slot name="footer">
        <p>
          Built from the H2 2025 harmonised DSA filings of the major platforms.
          Updated as new filings are published.
        </p>
        <p>
          Data is publicly queryable. See the <a href="/api">API documentation</a>.
        </p>
      </slot>
      <p class="footer-legal">
        <a href="/legal">Legal</a> &middot; Text and data under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>
      </p>
    </footer>

    <script>
      // Nav dropdowns: the label is a plain link to the hub; the caret toggles
      // the menu. Without JS the caret does nothing and the hub link still works.
      const navDropdowns = Array.from(document.querySelectorAll(".nav-dropdown"));
      function closeNavMenus() {
        navDropdowns.forEach((dd) => {
          dd.querySelector(".nav-menu")?.classList.remove("open");
          dd.querySelector(".nav-caret")?.setAttribute("aria-expanded", "false");
        });
      }
      navDropdowns.forEach((dd) => {
        const caret = dd.querySelector(".nav-caret");
        const menu = dd.querySelector(".nav-menu");
        if (!caret || !menu) return;
        caret.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = menu.classList.contains("open");
          closeNavMenus();
          if (!isOpen) {
            menu.classList.add("open");
            caret.setAttribute("aria-expanded", "true");
          }
        });
      });
      document.addEventListener("click", closeNavMenus);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeNavMenus();
      });
    </script>
  </body>
</html>