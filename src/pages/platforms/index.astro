---
// src/pages/platforms/index.astro
// Landing page for the per-provider data pages. Lists every provider,
// grouped by its service category, linking to /platforms/<slug>.

import Layout from "../../layouts/Layout.astro";
import { fetchFromSupabase } from "../../lib/supabase.js";

const providers = await fetchFromSupabase("provider_overview", {
  select: "provider_slug,provider_name,service_category,amar_eu_total,amar_eu_total_raw,amar_signed_in_eu_sum,amar_signed_out_eu_sum",
  order: "provider_name.asc",
});

// provider_overview is now one row per provider (main current service), but keep
// a de-dupe guard so this can't break if that ever changes.
const seen = new Set();
const unique = [];
for (const p of providers) {
  if (seen.has(p.provider_slug)) continue;
  seen.add(p.provider_slug);
  unique.push(p);
}

// Group by the provider's own service category, taken from the data rather than
// hardcoded, so App store, Knowledge, Travel and Adult content sit in the right
// place automatically and any future category still renders.
const groups = new Map();
for (const p of unique) {
  const cat = p.service_category || "Other";
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat).push(p);
}

// Preferred display order for the familiar categories; anything not listed falls
// to the end alphabetically. (If a heading lands in the wrong place, the exact
// service_category string differs from the guess below — adjust PREFERRED.)
const PREFERRED = [
  "Social media", "Video sharing", "Professional network",
  "Marketplace", "App store", "Travel", "Knowledge",
  "Adult content", "Other",
];
const orderedCategories = [...groups.keys()].sort((a, b) => {
  const ia = PREFERRED.indexOf(a);
  const ib = PREFERRED.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});

const fmt = (n) => (n == null ? null : Number(n).toLocaleString("en-GB"));

// AMAR display: official total, designation floor ("> 45" million), or, for the
// Google services, RTFP's per-country sums of signed-in / signed-out (labelled).
function amarLines(p) {
  if (p.amar_eu_total != null) return { lines: [`${fmt(p.amar_eu_total)} EU users`], agg: false };
  const m = (p.amar_eu_total_raw || "").match(/^\s*>\s*([\d.,]+)/);
  if (m) return { lines: [`More than ${m[1].replace(/,/g, "")} million EU users`], agg: false };
  const lines = [];
  if (p.amar_signed_in_eu_sum != null)  lines.push(`≈${fmt(p.amar_signed_in_eu_sum)} signed-in*`);
  if (p.amar_signed_out_eu_sum != null) lines.push(`≈${fmt(p.amar_signed_out_eu_sum)} signed-out*`);
  return lines.length ? { lines, agg: true } : null;
}
const hasAggregate = unique.some(
  (p) => p.amar_signed_in_eu_sum != null || p.amar_signed_out_eu_sum != null
);
---

<Layout title="Platforms | RTFP" description="Browse the full H2 2025 DSA transparency data for each of the platforms RTFP covers.">
  <h2>Platforms</h2>
  <p>
    The full set of figures RTFP holds for each platform's H2 2025 transparency
    filing. Select a platform to see its government orders, notices,
    own-initiative moderation, account actions and reporting metadata.
  </p>

  {orderedCategories.map((cat) => (
    <section class="category">
      <h3>{cat}</h3>
      <ul class="provider-list">
        {groups.get(cat).map((p) => (
          <li>
            <a href={`/platforms/${p.provider_slug}`}>
              <span class="name">{p.provider_name}</span>
              {(() => {
                const a = amarLines(p);
                if (!a) return null;
                return (
                  <span class={a.agg ? "amar amar-agg" : "amar"}>
                    {a.lines.map((line) => <span>{line}</span>)}
                  </span>
                );
              })()}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {hasAggregate && (
    <p class="amar-note">
      * No single EU total is published for these. The figure shown is RTFP's sum
      of the per-country counts the provider reported, with signed-in accounts and
      signed-out sessions kept separate (they measure different things and are not
      added together). See the platform's page for the full per-country breakdown.
    </p>
  )}
</Layout>

<style>
  .category { margin-bottom: 2rem; }
  .category h3 { margin-bottom: 0.75rem; }
  .provider-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  @media (max-width: 600px) { .provider-list { grid-template-columns: 1fr; } }
  .provider-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
    text-decoration: none;
  }
  .provider-list a:hover { border-color: var(--ink-faint); }
  .provider-list .name { font-weight: 600; color: var(--ink); }
  .provider-list .amar { font-size: 0.8rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .provider-list .amar-agg { display: flex; flex-direction: column; align-items: flex-end; gap: 0.1rem; text-align: right; }
  .amar-note { font-size: 0.8rem; color: var(--ink-faint); margin-top: 1.5rem; max-width: 70ch; line-height: 1.5; }
</style>