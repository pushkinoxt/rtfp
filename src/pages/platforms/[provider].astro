---
// src/pages/platforms/[provider].astro
//
// Per-provider "data dump" page. One template generates all twelve pages at
// build time via getStaticPaths(). URL: /platforms/<provider-slug>.
//
// Each page shows everything RTFP holds for one provider's H2 2025 filing:
// header metadata, government orders, notices, own-initiative moderation,
// appeals/disputes, and human-resource figures, with small inline SVG charts
// for the category breakdowns.

import Layout from "../../layouts/Layout.astro";
import { fetchFromSupabase } from "../../lib/supabase.js";
import { SUPPLEMENTARY_DOCUMENTS } from "../../data/supplementary_documents.js";
import { RESTATEMENTS } from "../../data/restatements.js";

export async function getStaticPaths() {
  // Generate one page per provider present in provider_overview.
  const providers = await fetchFromSupabase("provider_overview", {
    select: "provider_slug",
  });
  // De-duplicate slugs (provider_overview is one row per filing).
  const slugs = [...new Set(providers.map(p => p.provider_slug))];
  return slugs.map(slug => ({ params: { provider: slug } }));
}

const { provider } = Astro.params;
const eqProvider = `eq.${provider}`;

// Fetch everything for this one provider in parallel.
const [
  filingRows,
  overviewRows,
  govByCategory,
  noticesByCategory,
  moderationVolume,
  automationRows,
  accountActionsRows,
  platformNotesRows,
  caveatRows,
  adServiceRows,
  adAppeals,
  detectionRows,
] = await Promise.all([
  fetchFromSupabase("filings_overview", { filters: { provider_slug: eqProvider } }),
  fetchFromSupabase("provider_overview", { filters: { provider_slug: eqProvider } }),
  fetchFromSupabase("government_orders_by_category", {
    filters: { provider_slug: eqProvider },
    order: "orders_act_received.desc.nullslast",
  }),
  fetchFromSupabase("notices_by_category", {
    filters: { provider_slug: eqProvider },
    order: "notices_received.desc.nullslast",
  }),
  fetchFromSupabase("moderation_volume_comparison", {
    filters: { provider_slug: eqProvider },
  }),
  fetchFromSupabase("automation_share_by_provider", {
    filters: { provider_slug: eqProvider },
  }),
  fetchFromSupabase("account_actions_summary", {
    filters: { provider_slug: eqProvider },
  }),
  fetchFromSupabase("platform_notes", {
    filters: { provider_slug: eqProvider },
    order: "basis.asc,field_label.asc",
  }),
  fetchFromSupabase("provider_caveats", {
    filters: { provider_slug: eqProvider },
    order: "sort_order.asc",
  }),
  fetchFromSupabase("ad_services", { filters: { provider_slug: eqProvider } }),
  fetchFromSupabase("ad_service_appeals", { filters: { provider_slug: eqProvider } }),
  fetchFromSupabase("automated_means_accuracy", { filters: { provider_slug: eqProvider } }),
]);

const overview = overviewRows[0] ?? {};
// Pin the filing row to the same (current, primary) filing that overview and the
// analytical sections use, so the header can't drift to a superseded version or
// an ad service when filings_overview returns more than one row for this provider.
const filing =
  filingRows.find((f) => f.filing_id === overview.filing_id) ?? filingRows[0] ?? {};

const providerName = overview.provider_name ?? filing.provider_name ?? provider;
const legalEntity = overview.legal_entity ?? filing.legal_entity ?? "—";

const fmt = (n) =>
  n === null || n === undefined ? "—" : Number(n).toLocaleString("en-GB");

const fmtDate = (d) =>
  d ? new Date(d).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" }) : "—";

// Restatement note: fires for any filing that is a later version (Amazon, Snap),
// and now correctly states these are the restated figures, since the views point
// at the current version.
const isRestated = (filing.version_number ?? 1) > 1;

// Providers known to have restated their report whose original could not be
// separately retrieved, so only the restated version exists for them here.
const ORIGINAL_NOT_RETRIEVABLE = new Set(["shein"]);
const originalNotRetrievable = ORIGINAL_NOT_RETRIEVABLE.has(provider);

// --- Advertising service (Google only): a separate filing, never blended in ---
const adService = adServiceRows[0] ?? null;
const adServiceName =
  adService?.service_name ?? adAppeals[0]?.service_name ?? `${providerName} Ads`;
const hasAdData = adServiceRows.length > 0 || adAppeals.length > 0;

// --- Automated detection accuracy (file 08): per-provider reported figures ---
// context is heterogeneous (a tool name for XVideos, XNXX, Pornhub, Google
// Shopping; a methodology note or nothing for others), and the figures are not
// comparable across providers. Pivot to one row per (context, scope) carrying the
// three metric columns, aggregate scopes first, per-language behind a disclosure.
const hasDetection = detectionRows.length > 0;
const isAggScope = (s) => s == null || !/^[a-z]{2}$/i.test(String(s).trim());
const detectionPivot = (() => {
  const byKey = new Map();
  for (const r of detectionRows) {
    const key = `${r.context ?? ""}||${r.scope ?? ""}`;
    if (!byKey.has(key)) byKey.set(key, { context: r.context ?? null, scope: r.scope ?? null, Accuracy: null, Precision: null, Recall: null });
    const row = byKey.get(key);
    if (["Accuracy", "Precision", "Recall"].includes(r.metric)) row[r.metric] = r.value;
  }
  return [...byKey.values()].sort((a, b) => {
    const ag = Number(isAggScope(b.scope)) - Number(isAggScope(a.scope));
    if (ag) return ag;
    const c = (a.context ?? "").localeCompare(b.context ?? "");
    return c || (a.scope ?? "").localeCompare(b.scope ?? "");
  });
})();
const detAgg = detectionPivot.filter((r) => isAggScope(r.scope));
const detLang = detectionPivot.filter((r) => !isAggScope(r.scope));
const pctAcc = (v) => (v === null || v === undefined ? "—" : `${(Number(v) * 100).toFixed(1)}%`);

// --- Documents filed beyond the eleven harmonised CSVs (static catalogue) ---
const supDocs = SUPPLEMENTARY_DOCUMENTS[provider];
const hasSupDocs = Array.isArray(supDocs) && supDocs.length > 0;

// --- AMAR display: official total, designation floor, or per-country aggregate ---
const amarFloorMatch = (overview.amar_eu_total_raw || "").match(/^\s*>\s*([\d.,]+)/);
const amarFloorMillions = amarFloorMatch ? amarFloorMatch[1].replace(/,/g, "") : null;
const amarHasAggregate =
  overview.amar_signed_in_eu_sum != null || overview.amar_signed_out_eu_sum != null;

// For the aggregate (Google-style) providers, pull the per-country breakdown.
const amarByCountry = amarHasAggregate
  ? await fetchFromSupabase("amar_by_country", {
      filters: { provider_slug: eqProvider },
      order: "country_name.asc",
    })
  : [];
const amarCountryMap = new Map();
for (const r of amarByCountry) {
  if (!amarCountryMap.has(r.country_code)) {
    amarCountryMap.set(r.country_code, {
      country: r.country_name ?? r.country_code, signedIn: null, signedOut: null,
    });
  }
  const row = amarCountryMap.get(r.country_code);
  if (r.measure === "signed-in accounts") row.signedIn = r.amar;
  else if (r.measure === "signed-out sessions") row.signedOut = r.amar;
}
const amarCountryRows = [...amarCountryMap.values()];

// Platform's own narrative answers (Article 42 / Annex I), for the current filing.
const narrativeRows = overview.filing_id
  ? await fetchFromSupabase("qualitative_indicators", {
      filters: { filing_id: `eq.${overview.filing_id}` },
      order: "indicator.asc",
    })
  : [];
const narratives = narrativeRows.filter((n) => n.value && n.value.trim() !== "");

// Group the platform's contextual notes by reporting basis for display.
const notesByBasis = new Map();
for (const n of platformNotesRows) {
  if (!notesByBasis.has(n.basis)) notesByBasis.set(n.basis, []);
  notesByBasis.get(n.basis).push(n);
}
const noteBases = [...notesByBasis.keys()];

// --- Helpers for the small inline SVG bar charts ---
// Each chart takes [{label, value}] and renders a horizontal bar chart.
function topRows(rows, valueKey, n = 8) {
  return rows
    .filter(r => (r[valueKey] ?? 0) > 0)
    .slice(0, n)
    .map(r => ({
      label: r.category_label ?? r.category_code ?? "—",
      value: Number(r[valueKey] ?? 0),
    }));
}

const govChart = topRows(govByCategory, "orders_act_received");
const noticesChart = topRows(noticesByCategory, "notices_received");

// Own-initiative ToS TOTAL row (the big moderation headline).
const tcTotal = moderationVolume.find(r => r.basis === "tc" && r.level === "total");
const illegalTotal = moderationVolume.find(r => r.basis === "illegal" && r.level === "total");
const tcAutomation = automationRows.find(r => r.basis === "tc");

// --- Restatement detail (config-driven): a figure panel or a specific note ---
// The generic note already states this is a restated version. This adds the
// specifics. For a figure restatement we read the moved figure from BOTH
// versions so both numbers come from the data and cannot drift; for a re-issue
// we show the configured note. Providers absent from RESTATEMENTS show neither.
const restatement = RESTATEMENTS[provider] ?? null;
const restNote = restatement?.form === "note" ? restatement.note : null;

// The immediate previous version, when filings_overview returned it (it joins
// every version). Used to read the original figure for a figure restatement.
const prevFiling = filingRows
  .filter((f) => (f.version_number ?? 1) < (filing.version_number ?? 1))
  .sort((a, b) => (b.version_number ?? 1) - (a.version_number ?? 1))[0] ?? null;

let restFigure = null;
if (restatement?.form === "figures" && restatement.metric && prevFiling?.filing_id) {
  const basis = restatement.metric.basis;
  const table = basis === "illegal" ? "own_initiative_illegal" : "own_initiative_tc";
  // Read the grand-total row (category_code TOTAL) of the previous version, the
  // same row the moderation view surfaces as level 'total' for the current one.
  const prevTotalRows = await fetchFromSupabase(table, {
    filters: { filing_id: `eq.${prevFiling.filing_id}`, category_code: "eq.TOTAL" },
  });
  const originalValue = prevTotalRows[0]?.measures_total ?? null;
  const restatedValue =
    (basis === "illegal" ? illegalTotal : tcTotal)?.measures_total ?? null;
  if (originalValue != null && restatedValue != null) {
    restFigure = {
      label: restatement.metric.label,
      original: originalValue,
      restated: restatedValue,
    };
  }
}

// Restriction-type breakdown from the ToS TOTAL row.
const restrictionRows = tcTotal
  ? [
      { label: "Visibility (removal)", value: tcTotal.vis_removal },
      { label: "Visibility (disable)", value: tcTotal.vis_disable },
      { label: "Visibility (demoted)", value: tcTotal.vis_demoted },
      { label: "Visibility (age-restricted)", value: tcTotal.vis_age_restricted },
      { label: "Visibility (interaction-restricted)", value: tcTotal.vis_interaction_restricted },
      { label: "Visibility (labelled)", value: tcTotal.vis_labelled },
      { label: "Monetary (suspension)", value: tcTotal.mon_suspension },
      { label: "Monetary (termination)", value: tcTotal.mon_termination },
      { label: "Service (suspension)", value: tcTotal.svc_suspension },
      { label: "Service (termination)", value: tcTotal.svc_termination },
      { label: "Account (suspension)", value: tcTotal.acc_suspension },
      { label: "Account (termination)", value: tcTotal.acc_termination },
    ].filter(r => (r.value ?? 0) > 0)
  : [];

const accountActions = accountActionsRows.find(r => r.basis === "tc")
  ?? accountActionsRows.find(r => r.basis === "illegal")
  ?? {};

const title = `${providerName} DSA transparency data | RTFP`;
const description = `Everything RTFP holds from ${providerName}'s H2 2025 EU Digital Services Act transparency filing.`;

// Max value for chart scaling
function chartMax(rows) {
  return Math.max(1, ...rows.map(r => r.value));
}
---

<Layout title={title} description={description}>
  <p class="breadcrumb"><a href="/platforms">← All platforms</a></p>

  <h2>{providerName}</h2>
  <p class="entity">{legalEntity}</p>

  <dl class="meta">
    <div><dt>Reporting period</dt><dd>{fmtDate(filing.period_start)} – {fmtDate(filing.period_end)}</dd></div>
    <div><dt>Published</dt><dd>{fmtDate(filing.this_version_published_on)}</dd></div>
    <div>
      <dt>EU average monthly active recipients</dt>
      <dd>
        {overview.amar_eu_total != null ? (
          fmt(overview.amar_eu_total)
        ) : amarFloorMillions != null ? (
          `More than ${amarFloorMillions} million`
        ) : amarHasAggregate ? (
          <span class="amar-agg">
            {overview.amar_signed_in_eu_sum != null && (
              <span>≈{fmt(overview.amar_signed_in_eu_sum)} signed-in accounts*</span>
            )}
            {overview.amar_signed_out_eu_sum != null && (
              <span>≈{fmt(overview.amar_signed_out_eu_sum)} signed-out sessions*</span>
            )}
          </span>
        ) : "—"}
      </dd>
    </div>
    <div><dt>Service category</dt><dd>{overview.service_category ?? "—"}</dd></div>
    <div><dt>Designated</dt><dd>{fmtDate(overview.designated_on)}</dd></div>
    <div><dt>Established in</dt><dd>{overview.country_of_establishment ?? "—"}</dd></div>
  </dl>

  {isRestated && !originalNotRetrievable && (
    <p class="restatement-note">
      These are {providerName}'s restated H2 2025 figures (version {filing.version_number},
      published {fmtDate(filing.this_version_published_on)}), which supersede an
      earlier version published {fmtDate(filing.original_published_on)}. Both
      versions are listed on the <a href="/sources">sources page</a>, and a
      side-by-side comparison of the two is planned.
    </p>
  )}

  {originalNotRetrievable && (
    <p class="restatement-note">
      These are {providerName}'s restated H2 2025 figures. The original version was not separately
      retrievable, so only this version is shown.
    </p>
  )}

  {restFigure && (
    <div class="restatement-detail">
      <p class="restatement-detail-label">What the restatement changed</p>
      <div class="restatement-figure">
        <span class="rf-metric">{restFigure.label}</span>
        <span class="rf-values">
          <span class="rf-from">{fmt(restFigure.original)}</span>
          <span class="rf-arrow" aria-hidden="true">&rarr;</span>
          <span class="rf-to">{fmt(restFigure.restated)}</span>
        </span>
      </div>
    </div>
  )}

  {restNote && (
    <div class="restatement-detail">
      <p class="restatement-detail-label">What the restatement changed</p>
      <p class="restatement-detail-text">{restNote}</p>
    </div>
  )}

  {amarHasAggregate && (
    <section class="data-section">
      <h3>Average monthly active recipients, by Member State</h3>
      <p class="article-ref">Article 24(2)</p>
      <p class="amar-method">
        {providerName} does not publish a single EU-wide figure. It reports
        recipients per Member State, split into signed-in accounts and signed-out
        sessions, and points to a consolidated PDF report for any total. The
        figures marked "*" above are RTFP's own sums across the {overview.amar_country_count}
        Member States listed here. Signed-in accounts and signed-out sessions
        measure different things and are never added together, and neither sum is
        an official figure {providerName} stated.
      </p>
      <table class="data-table amar-table">
        <thead>
          <tr><th>Member State</th><th>Signed-in accounts</th><th>Signed-out sessions</th></tr>
        </thead>
        <tbody>
          {amarCountryRows.map((r) => (
            <tr>
              <td>{r.country}</td>
              <td>{r.signedIn ?? "—"}</td>
              <td>{r.signedOut ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <!-- Government orders -->
  <section class="data-section">
    <h3>Government orders to act against illegal content</h3>
    <p class="article-ref">Article 15(1)(a)</p>
    {govChart.length > 0 ? (
      <div class="bar-chart">
        {govChart.map(row => (
          <div class="bar-row">
            <span class="bar-label">{row.label}</span>
            <span class="bar-track">
              <span class="bar-fill" style={`width: ${(row.value / chartMax(govChart) * 100).toFixed(1)}%`}></span>
            </span>
            <span class="bar-value">{fmt(row.value)}</span>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty">No government orders reported, or all categories reported zero.</p>
    )}
  </section>

  <!-- Notices -->
  <section class="data-section">
    <h3>Notices received from users and flaggers</h3>
    <p class="article-ref">Article 16</p>
    {noticesChart.length > 0 ? (
      <div class="bar-chart">
        {noticesChart.map(row => (
          <div class="bar-row">
            <span class="bar-label">{row.label}</span>
            <span class="bar-track">
              <span class="bar-fill" style={`width: ${(row.value / chartMax(noticesChart) * 100).toFixed(1)}%`}></span>
            </span>
            <span class="bar-value">{fmt(row.value)}</span>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty">No notices reported by category.</p>
    )}
  </section>

  <!-- Own-initiative moderation -->
  <section class="data-section">
    <h3>Own-initiative moderation</h3>
    <p class="article-ref">Article 15(1)(c) and (d)</p>

    <div class="stat-grid">
      <div class="stat">
        <span class="stat-number">{fmt(tcTotal?.measures_total)}</span>
        <span class="stat-label">Actions under terms &amp; conditions</span>
      </div>
      <div class="stat">
        <span class="stat-number">{fmt(illegalTotal?.measures_total)}</span>
        <span class="stat-label">Actions against illegal content</span>
      </div>
      <div class="stat">
        <span class="stat-number">{tcAutomation?.automation_share_pct != null ? `${tcAutomation.automation_share_pct}%` : "—"}</span>
        <span class="stat-label">Share taken solely by automated means (ToS)</span>
      </div>
    </div>

    {restrictionRows.length > 0 && (
      <>
        <h4>Restriction types applied (terms &amp; conditions)</h4>
        <div class="bar-chart">
          {restrictionRows
            .sort((a, b) => b.value - a.value)
            .map(row => (
              <div class="bar-row">
                <span class="bar-label">{row.label}</span>
                <span class="bar-track">
                  <span class="bar-fill" style={`width: ${(row.value / chartMax(restrictionRows) * 100).toFixed(1)}%`}></span>
                </span>
                <span class="bar-value">{fmt(row.value)}</span>
              </div>
            ))}
        </div>
      </>
    )}
  </section>

  <!-- Account actions -->
  <section class="data-section">
    <h3>Account-level actions</h3>
    <p class="article-ref">Article 15(1)(d)</p>
    <table class="data-table">
      <tbody>
        <tr><th>Account suspensions</th><td>{fmt(accountActions.account_suspensions)}</td></tr>
        <tr><th>Account terminations</th><td>{fmt(accountActions.account_terminations)}</td></tr>
        <tr><th>Total account actions</th><td>{fmt(accountActions.total_account_actions)}</td></tr>
      </tbody>
    </table>
  </section>

  {hasAdData && (
    <section class="data-section ad-section">
      <h3>Advertising service</h3>
      <p class="section-intro">
        {adServiceName} is {providerName}'s advertising surface, moderated and
        reported separately from the platform itself. Only Google reports advertising
        moderation as a separate service. These figures are <strong>not</strong> part
        of {providerName}'s headline numbers above.
      </p>

      {adService && (
        <div class="stat-grid">
          <div class="stat">
            <span class="stat-number">{fmt(adService.own_initiative_tc_measures)}</span>
            <span class="stat-label">Own-initiative actions (terms &amp; conditions)</span>
          </div>
          <div class="stat">
            <span class="stat-number">{adService.automation_share_pct != null ? `${adService.automation_share_pct}%` : "—"}</span>
            <span class="stat-label">Share taken solely by automated means</span>
          </div>
        </div>
      )}

      {adAppeals.length > 0 && (
        <details class="notes-details">
          <summary>Show advertising appeals figures ({adAppeals.length})</summary>
          <table class="data-table ad-appeals-table">
            <tbody>
              {adAppeals.map((a) => (
                <tr><th>{a.indicator}</th><td>{fmt(a.value)}</td></tr>
              ))}
            </tbody>
          </table>
        </details>
      )}

      <p class="section-note">
        Full per-tool and per-language advertising detail is in
        <a href="/explore">Explore</a> (<code>ad_services</code>,
        <code>ad_service_appeals</code>, <code>ad_service_automation</code>).
      </p>
    </section>
  )}

  {hasDetection && (
    <section class="data-section">
      <h3>Automated detection accuracy</h3>
      <p class="section-intro">
        {providerName} reports the accuracy of its automated detection. These are its own
        figures, measured against its own method and denominators, and are not comparable
        with other providers'. The detection tool or method is shown as filed.
      </p>

      {detAgg.length > 0 && (
        <table class="data-table detection-table">
          <thead>
            <tr><th>Tool or method</th><th>Scope</th><th>Accuracy</th><th>Precision</th><th>Recall</th></tr>
          </thead>
          <tbody>
            {detAgg.map((r) => (
              <tr>
                <td>{r.context ?? "—"}</td>
                <td>{r.scope ?? "—"}</td>
                <td>{pctAcc(r.Accuracy)}</td>
                <td>{pctAcc(r.Precision)}</td>
                <td>{pctAcc(r.Recall)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {detLang.length > 0 && (
        <details class="notes-details">
          <summary>Show per-language figures ({detLang.length})</summary>
          <table class="data-table detection-table">
            <thead>
              <tr><th>Tool or method</th><th>Language</th><th>Accuracy</th><th>Precision</th><th>Recall</th></tr>
            </thead>
            <tbody>
              {detLang.map((r) => (
                <tr>
                  <td>{r.context ?? "—"}</td>
                  <td>{r.scope ?? "—"}</td>
                  <td>{pctAcc(r.Accuracy)}</td>
                  <td>{pctAcc(r.Precision)}</td>
                  <td>{pctAcc(r.Recall)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      )}

      <p class="section-note">
        Full per-tool and per-language detection figures are in
        <a href="/explore">Explore</a> (<code>automated_means_accuracy</code>).
      </p>
    </section>
  )}

  {narratives.length > 0 && (
    <section class="data-section">
      <h3>In {providerName}'s words</h3>
      <p class="section-intro">
        {providerName}'s long-form answers to the standard qualitative questions
        every platform must answer (Article 42 of the DSA). How it moderates
        content, how it measures accuracy, how its teams are resourced. Its own
        words. Expand each to read. (Short notes pinned to individual figures are
        under "Footnotes from {providerName}" below.)
      </p>
      {narratives.map((n) => (
        <details class="narrative">
          <summary>{n.indicator}</summary>
          <div class="narrative-body">{n.value}</div>
        </details>
      ))}
    </section>
  )}

  {hasSupDocs && (
    <section class="data-section">
      <h3>Beyond the eleven files</h3>
      <p class="section-intro">
        Alongside the eleven harmonised CSV files, {providerName} also published the following. These sit
        outside the comparable dataset and are listed here for completeness.
      </p>
      <ul class="doc-list">
        {supDocs.map((d) => (
          <li><span class="doc-title">{d.title}.</span> {d.summary}</li>
        ))}
      </ul>
      <p class="section-note">
        These are published on {providerName}'s own transparency page, linked from <a href="/sources">Sources</a>.
      </p>
    </section>
  )}

  <!-- Footer / raw data -->
  <section class="data-section">
    <h3>Raw data</h3>
    <p>
      Every figure on this page comes from {providerName}'s filing as loaded into
      RTFP's public database. You can query the underlying data directly via the
      <a href="/api">public API</a>. The original filing is linked from the
      <a href="/sources">sources page</a>.
    </p>
  </section>

  {noteBases.length > 0 && (
    <section class="data-section notes-section">
      <h3>Footnotes from {providerName}</h3>
      <p class="section-intro">
