                    <span class="note-text">{n.note}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </section>
  )}

  {caveatRows.length > 0 && (
    <section class="data-section caveats-section">
      <h3>RTFP notes</h3>
      <p class="section-intro">
        RTFP's own observations about comparability and data gaps for {providerName},
