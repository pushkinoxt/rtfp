---
// src/pages/index.astro
// RTFP home page — headline findings from the H2 2025 harmonised filings

import Layout from "../layouts/Layout.astro";
import { fetchFromSupabase } from "../lib/supabase.js";

const [providers, automation, accountActions, ooc, languageCoverage] = await Promise.all([
  fetchFromSupabase("provider_overview", {
    select: "provider_slug,provider_name,amar_eu_total",
    order: "amar_eu_total.desc.nullslast",
  }),
  fetchFromSupabase("automation_share_by_provider", {
    filters: { basis: "eq.tc" },
    select: "provider_name,automation_share_pct",
    order: "automation_share_pct.desc.nullslast",
  }),
  fetchFromSupabase("headline_metrics_normalised", {
    filters: { metric_key: "eq.account_actions", dimension_key: "eq.all" },
    select: "provider_name,absolute_value,per_million_amar",
    order: "per_million_amar.desc.nullslast",
  }),
  fetchFromSupabase("out_of_court_disputes", {
    select: "provider_name,disputes_submitted,share_provider_implemented_pct",
    order: "disputes_submitted.desc.nullslast",
  }),
  fetchFromSupabase("disclosure_coverage", {
    filters: {
      is_reported: "eq.false",
      disclosure_label: "eq.Moderators reported for all 24 EU official languages",
    },
    select: "provider_name,value_if_reported",
  }),
]);

const providerCount = providers.length;
const totalAmar = providers.reduce((sum, p) => sum + (p.amar_eu_total ?? 0), 0);

// Findings that name a specific provider use .find() so they stay correct
// regardless of how many providers are loaded.
const xAutomation = automation.find(a => a.provider_name === "X");
const sheinAutomation = automation.find(a => a.provider_name === "Shein");
const pinterestAutomation = automation.find(a => a.provider_name === "Pinterest");
const instaTermination = accountActions.find(a => a.provider_name === "Instagram");
const xPerUser = accountActions.find(a => a.provider_name === "X");
const tiktokPerUser = accountActions.find(a => a.provider_name === "TikTok");
const linkedinLanguages = languageCoverage.find(l => l.provider_name === "LinkedIn");
const temuProvider = providers.find(p => p.provider_name === "Temu");
const temuReportsNoAmar = temuProvider ? (temuProvider.amar_eu_total == null) : false;

const fmt = (n) => n?.toLocaleString("en-GB") ?? "—";

// X-vs-TikTok per-user multiple, computed rather than hardcoded.
const xVsTiktokMultiple =
  xPerUser && tiktokPerUser && tiktokPerUser.per_million_amar
    ? (xPerUser.per_million_amar / tiktokPerUser.per_million_amar)
    : null;

// --- Point-in-time figures (H2 2025 v1 data) ---
// These come from views whose column names aren't yet wired into this page.
// They are accurate for the current data cycle. To make them live, replace
// with fetches from moderation_volume_comparison and government_orders_summary
// once their column names are confirmed.
const temuTotalMeasures = 768352129;     // Temu, own-initiative ToS, TOTAL
const socialTotalMeasures = 706911338;   // Sum of the 7 social platforms
const amazonGovOrders = 947;             // Amazon Store, orders to act
const facebookGovOrders = 1358;          // Facebook, orders to act (the max)

const title = "RTFP — Reading The Fine Print";
const description = "A cross-platform comparison of the EU Digital Services Act transparency filings of the largest platforms out there";
---

<Layout title={title} description={description}>
  <h2>Headline findings from the first harmonised DSA filings</h2>
  <p>
    Since H2 2025, the largest platforms have been required to file their EU
    transparency reports in a common format. For the first time, their numbers
    can be compared directly. These are some comparisons worth knowing from
    the harmonised filings of the largest social platforms and marketplaces.
  </p>
  <p class="amar-footnote">
    Coverage: {providerCount} platforms. Combined EU average monthly active
    recipients across them: {fmt(totalAmar)}.
  </p>

  <section class="findings">
    <article class="finding hero">
      <p class="number">{Math.round(temuTotalMeasures / 1e6)}M</p>
      <p class="number-context">Temu — own-initiative moderation actions, H2 2025</p>
      <h3>One marketplace out-moderated every social platform combined</h3>
      <p>
        Temu reported {fmt(temuTotalMeasures)} content moderation actions taken
        on its own initiative under its terms and conditions — more than the
        seven social platforms in this dataset added together
        (about {fmt(socialTotalMeasures)}). The platform most associated with
        consumer goods reported more moderation activity than TikTok,
        Facebook, Instagram, X, Snapchat, Pinterest and LinkedIn put together.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{sheinAutomation?.automation_share_pct ?? 0}%</p>
      <p class="number-context">Shein — share of moderation taken solely by automated means</p>
      <h3>Social platforms automate heavily - marketplaces don't agree</h3>
      <p>
        All seven social platforms report automating between roughly 78% and
        99% of their terms-and-conditions moderation
        (X {xAutomation?.automation_share_pct ?? "—"}%,
        Pinterest {pinterestAutomation?.automation_share_pct ?? "—"}%).
        Marketplaces scatter from 0% to 97%. The three least-automated
        moderators of all {providerCount} are marketplaces.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{fmt(amazonGovOrders)}</p>
      <p class="number-context">Amazon Store — government orders to act against illegal content</p>
      <h3>A shopping platform fields the second-most government takedown orders</h3>
      <p>
        Government orders to remove illegal content are usually imagined as a
        social-media matter. Yet Amazon Store received {fmt(amazonGovOrders)}
        such orders from EU member state authorities in H2 2025 — second only
        to Facebook ({fmt(facebookGovOrders)}), and ahead of TikTok, Instagram
        and every other platform in the dataset.
      </p>
      <a class="more" href="/compare/government-orders">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{temuReportsNoAmar ? "n/a" : fmt(temuProvider?.amar_eu_total)}</p>
      <p class="number-context">Temu — average monthly active recipients reported</p>
      <h3>The largest moderator doesn't disclose how large it is</h3>
      <p>
        Temu reported the most moderation activity of any platform here, but
        left its average-monthly-active-recipients figure blank in the filing. Without a user
        base, its moderation cannot be expressed per user — the measure that
        makes platforms of different sizes comparable. 
      </p>
      <a class="more" href="/sources">See the sources →</a>
    </article>

    <article class="finding">
      <p class="number">{fmt(instaTermination?.absolute_value)}</p>
      <p class="number-context">Instagram — accounts terminated in EU, H2 2025</p>
      <h3>Instagram terminated tens of millions of EU accounts in six months</h3>
      <p>
        Sustained across 184 days. Instagram does not suspend accounts — it
        only terminates. A binary policy applied at industrial scale.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{linkedinLanguages?.value_if_reported ?? 12}/24</p>
      <p class="number-context">LinkedIn — official EU languages with reported moderators</p>
      <h3>LinkedIn doesn't staff half the EU's official languages</h3>
      <p>
        Czech, Danish, Estonian, Greek, Hungarian, Latvian, Romanian, Slovak,
        Slovenian, Swedish, Maltese, and Irish — all reported as zero
        moderators. LinkedIn has hundreds of thousands of Greek users and
        zero Greek-speaking moderators.
      </p>
      <a class="more" href="/compare/languages">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">~0%</p>
      <p class="number-context">Out-of-court dispute implementation rate, several platforms</p>
      <h3>Platforms rarely implement independent dispute review</h3>
      <p>
        Article 21 lets users escalate moderation decisions to certified
        out-of-court dispute bodies. Across the filings, several platforms
        report implementing none or almost none of those bodies' decisions.
        The reported figures range from zero to a few percent, with encoding
        ambiguity making some hard to interpret.
      </p>
      <a class="more" href="/compare/appeals">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">
        {xPerUser ? Number(xPerUser.per_million_amar / 1000).toFixed(1) : "—"}
      </p>
      <p class="number-context">X — account actions per thousand EU users</p>
      <h3>
        X enforces far more per user than TikTok{
          xVsTiktokMultiple ? ` — about ${xVsTiktokMultiple.toFixed(0)}×` : ""
        }
      </h3>
      <p>
        After controlling for platform size, X's per-user enforcement rate is
        many times higher than TikTok's, even where TikTok reports more actions
        in absolute terms. Per-user rates expose differences that raw totals
        hide.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>
  </section>
</Layout>

<style>
  .amar-footnote { font-size: 0.9rem; color: var(--ink-faint); margin-top: 1rem; margin-bottom: 2rem; }

  .findings { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2rem; }
  @media (min-width: 768px) {
    .findings { grid-template-columns: 1fr 1fr; }
    .findings .hero { grid-column: 1 / -1; }
  }

  .finding {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .finding .number {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.25rem;
    color: var(--ink);
  }
  .finding .number-context {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }
  .finding h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem !important;
  }
  .finding p { font-size: 0.95rem; margin: 0; }
  .finding .more {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
  }
</style>