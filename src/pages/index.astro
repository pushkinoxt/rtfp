---
// src/pages/index.astro
// RTFP home. Kept deliberately short: a tight hero, two pulled-out findings as
// the one prominent element, and a terse grid of routes into the rest of the
// site. Orient a first-time visitor, give them a reason to look closer, send
// them on. Headline patterns live under /patterns; the divergences under
// /fine-print.

import Layout from "../layouts/Layout.astro";
import { fetchFromSupabase } from "../lib/supabase.js";

const providers = await fetchFromSupabase("provider_overview", {
  select: "provider_slug",
});
const providerCount = new Set(providers.map((p) => p.provider_slug)).size;

const findings = [
  {
    statement: "The numbers don't always line up.",
    detail:
      "Under one harmonised template, platforms still count the same things in different ways.",
    href: "/fine-print/footnotes",
    cue: "Where they diverge",
  },
  {
    statement: "Most moderation runs without a human.",
    detail:
      "The large majority of enforcement actions are taken by automated systems, not people.",
    href: "/patterns/automation-share",
    cue: "See the split",
  },
];

const destinations = [
  { href: "/platforms", name: "Platforms", blurb: "Browse any one platform's full filing." },
  { href: "/explore", name: "Explore", blurb: "Query the whole database in the browser." },
  { href: "/patterns", name: "Patterns", blurb: "Composition and coverage across platforms." },
  { href: "/sources", name: "Sources", blurb: "Every figure traced to its own filing." },
  { href: "/api", name: "API", blurb: "The same data as a read-only REST API." },
  { href: "/fine-print", name: "The Fine Print", blurb: "How it is built, and where it diverges." },
];

const title = "RTFP: Read The Fine Print";
const description =
  "A cross-platform comparison of the EU Digital Services Act transparency filings of the largest platforms, loaded into one queryable database.";
---

<Layout title={title} description={description}>
  <section class="hero">
    <h2>Platform transparency reporting, side by side</h2>
    <p class="standfirst">
      Since the second half of 2025, the largest online platforms file their EU
      Digital Services Act transparency reports to one harmonised template. RTFP
      loads every filing into a single queryable database, so the figures can
      finally be compared and the fine print read.
    </p>
    <p class="why">
      The reports are public but scattered. As far as we can tell, no one had
      made them queryable in one place, so we did.
    </p>
    <p class="coverage">{providerCount} platforms · H2 2025 · eleven harmonised files each</p>
  </section>

  <section class="findings" aria-label="A couple of findings">
    {findings.map((f) => (
      <a class="finding" href={f.href}>
        <span class="finding-statement">{f.statement}</span>
        <span class="finding-detail">{f.detail}</span>
        <span class="finding-cue">{f.cue} →</span>
      </a>
    ))}
  </section>

  <nav class="destinations" aria-label="Site sections">
    {destinations.map((d) => (
      <a class="destination" href={d.href}>
        <span class="destination-name">{d.name} →</span>
        <span class="destination-blurb">{d.blurb}</span>
      </a>
    ))}
  </nav>

  <section class="footnote">
    <p>
      RTFP is in a trial phase. It is an independent, non-commercial comparison
      built from platforms' own self-reported filings, and it is not an audit.
      More on the <a href="/about">about page</a>.
    </p>
  </section>
</Layout>

<style>
  .hero { max-width: 44rem; }
  .hero h2 { font-size: 1.9rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 1.1rem; }
  .standfirst { font-size: 1.12rem; color: var(--ink); line-height: 1.6; margin: 0 0 1rem; }
  .why { font-size: 0.96rem; color: var(--ink-dim); line-height: 1.6; margin: 0 0 1.4rem; }
  .coverage {
    font-size: 0.84rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .findings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.25rem;
    margin: 2.75rem 0 3rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 620px) { .findings { grid-template-columns: 1fr; gap: 1.75rem; } }

  .finding { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none !important; }
  .finding-statement {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: 1.2;
  }
  .finding-detail { font-size: 0.92rem; color: var(--ink-dim); line-height: 1.55; }
  .finding-cue { font-size: 0.82rem; color: var(--ink-faint); margin-top: 0.15rem; }
  .finding:hover .finding-statement { text-decoration: underline; text-underline-offset: 3px; }
  .finding:hover .finding-cue { color: var(--ink-dim); }

  .destinations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.85rem;
    margin: 0 0 2.75rem;
  }
  .destination {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    text-decoration: none !important;
  }
  .destination:hover { border-color: var(--ink-faint); }
  .destination-name { font-weight: 600; color: var(--ink); font-size: 0.98rem; }
  .destination-blurb { font-size: 0.86rem; color: var(--ink-dim); line-height: 1.45; }

  .footnote { border-top: 1px solid var(--border); padding-top: 1.5rem; }
  .footnote p { font-size: 0.9rem; color: var(--ink-faint); margin: 0; max-width: 44rem; }
</style>