---
// src/pages/index.astro
// RTFP home page — a short introduction and a very short "about", with clear
// routes into the rest of the site. The headline findings now live at
// /findings; this page orients a first-time visitor before sending them on.

import Layout from "../layouts/Layout.astro";
import { fetchFromSupabase } from "../lib/supabase.js";

const providers = await fetchFromSupabase("provider_overview", {
  select: "provider_slug,provider_name,amar_eu_total",
});

// provider_overview is one row per filing — de-duplicate to one row per provider.
const seen = new Set();
const unique = [];
for (const p of providers) {
  if (seen.has(p.provider_slug)) continue;
  seen.add(p.provider_slug);
  unique.push(p);
}
const providerCount = unique.length;
const totalAmar = unique.reduce((sum, p) => sum + (p.amar_eu_total ?? 0), 0);
const fmt = (n) => (n == null ? "—" : Number(n).toLocaleString("en-GB"));

const destinations = [
  {
    href: "/data",
    name: "Platforms",
    blurb: "Browse the full filing for any one platform: government orders, notices, moderation, account actions.",
  },
  {
    href: "/explore",
    name: "Explore the data",
    blurb: "Query every view in the database from the browser. Search, filter, sort and download — no code needed.",
  },
  {
    href: "/sources",
    name: "Sources",
    blurb: "Every figure traced back to the provider's own published filing, linked in its canonical location.",
  },
  {
    href: "/api",
    name: "API",
    blurb: "The same data as a public read-only REST API. Open credential, documented endpoints.",
  },
];

const title = "RTFP — Read The Fine Print";
const description = "A cross-platform comparison of the EU Digital Services Act transparency filings of the largest platforms — loaded into one queryable database.";
---

<Layout title={title} description={description}>
  <section class="intro">
    <h2>DSA transparency report data: all in one place</h2>
    <p class="lede">
      Since H2 2025, the largest online platforms have had to file their EU
      Digital Services Act transparency reports in one harmonised format. For
      the first time, their numbers can be compared directly. We load those
      filings into a single normalised database and make it queryable.
    </p>
    <p class="why">
      The Commission and others publish lists of where these reports live. As 
      far as we can tell, the data isn't queryable somewhere, in one place. 
      Which we thought was, sort of, the point of the Implementing Regulation. 
      So we made RTFP. Every figure traceable to the provider's own filing, comparable, visible.
    </p>
    <p class="scale">
      Currently covering the H2 2025 filings of {providerCount} platforms —
      total combined EU average monthly active recipients data across all platforms:
      {fmt(totalAmar)}. More to come.
    </p>
  </section>

  <nav class="destinations" aria-label="Site sections">
    {destinations.map((d) => (
      <a class="destination" href={d.href}>
        <span class="destination-name">{d.name} →</span>
        <span class="destination-blurb">{d.blurb}</span>
      </a>
    ))}
  </nav>

  <section class="footnote">
    <p>
      RTFP is in a trial phase: an independent, non-commercial comparison built
      from platforms' self-reported filings. It is not an audit. Read more on
      the <a href="/about">about page</a>.
    </p>
  </section>
</Layout>

<style>
  .intro { max-width: 42rem; }
  .intro h2 { margin-bottom: 1.25rem; }
  .lede { font-size: 1.15rem; color: var(--ink); }
  .why { color: var(--ink-dim); }
  .scale {
    font-size: 0.9rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    margin-top: 1.5rem;
  }

  .destinations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 3rem 0 2.5rem;
  }
  @media (max-width: 600px) { .destinations { grid-template-columns: 1fr; } }

  .destination {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.4rem;
    text-decoration: none !important;
  }
  .destination:hover { border-color: var(--ink-faint); }
  .destination-name {
    font-weight: 600;
    color: var(--ink);
    font-size: 1.05rem;
  }
  .destination-blurb {
    font-size: 0.9rem;
    color: var(--ink-dim);
    line-height: 1.5;
  }

  .footnote { border-top: 1px solid var(--border); padding-top: 1.5rem; }
  .footnote p { font-size: 0.9rem; color: var(--ink-faint); margin: 0; }
</style>