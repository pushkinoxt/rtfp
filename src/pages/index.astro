---
// src/pages/index.astro
// RTFP home page — headline findings from the H2 2025 harmonised filings

import Layout from "../layouts/Layout.astro";
import { fetchFromSupabase } from "../lib/supabase.js";

const [providers, automation, accountActions, ooc, languageCoverage] = await Promise.all([
  fetchFromSupabase("provider_overview", {
    select: "provider_slug,provider_name,amar_eu_total",
    order: "amar_eu_total.desc.nullslast",
  }),
  fetchFromSupabase("automation_share_by_provider", {
    filters: { basis: "eq.tc" },
    select: "provider_name,automation_share_pct",
    order: "automation_share_pct.desc.nullslast",
  }),
  fetchFromSupabase("headline_metrics_normalised", {
    filters: { metric_key: "eq.account_actions", dimension_key: "eq.all" },
    select: "provider_name,absolute_value,per_million_amar",
    order: "per_million_amar.desc.nullslast",
  }),
  fetchFromSupabase("out_of_court_disputes", {
    select: "provider_name,disputes_submitted,share_provider_implemented_pct",
    order: "disputes_submitted.desc.nullslast",
  }),
  fetchFromSupabase("disclosure_coverage", {
    filters: {
      is_reported: "eq.false",
      disclosure_label: "eq.Moderators reported for all 24 EU official languages",
    },
    select: "provider_name,value_if_reported",
  }),
]);

const totalAmar = providers.reduce((sum, p) => sum + (p.amar_eu_total ?? 0), 0);
const topAutomation = automation[0];
const topPerUserActions = accountActions[0];
const instaTermination = accountActions.find(a => a.provider_name === "Instagram");
const linkedinLanguages = languageCoverage.find(l => l.provider_name === "LinkedIn");

const fmt = (n) => n?.toLocaleString("en-GB") ?? "—";

const title = "RTFP — Reading The Fine Print";
const description = "A cross-platform comparison of the EU Digital Services Act transparency filings";
---

<Layout title={title} description={description}>
  <h2>Five findings from the first harmonised DSA filings</h2>
  <p>
    Since H2 2025, the largest platforms have been required to file their EU
    transparency reports in a common format. For the first time, their numbers
    can be compared directly. These are five comparisons worth knowing from
    our initial sampling of Instagram, TikTok, LinkedIn and X.
  </p>
  <p class="amar-footnote">
    Combined EU monthly active users across the four platforms: {fmt(totalAmar)}.
  </p>

  <section class="findings">
    <article class="finding hero">
      <p class="number">{topAutomation.automation_share_pct}%</p>
      <p class="number-context">{topAutomation.provider_name} — share of moderation taken solely by automated means</p>
      <h3>X automates 93% of its moderation</h3>
      <p>
        Despite previously claiming near-zero automation, X reports under the
        harmonised template that 93.4% of moderation actions were taken
        "solely by automated means." Either the methodology changed or the
        new template forced disclosure of automation previously uncounted.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{fmt(instaTermination.absolute_value)}</p>
      <p class="number-context">Instagram — accounts terminated in EU, H2 2025</p>
      <h3>Instagram terminated 27.3 million EU accounts in six months</h3>
      <p>
        Roughly 4,500 per hour, sustained for 184 days. Instagram does not
        suspend accounts - it only terminates. A binary policy applied at
        industrial scale.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">0.4%</p>
      <p class="number-context">Out-of-court dispute implementation rate, three of four platforms</p>
      <h3>Platforms ignore independent dispute review</h3>
      <p>
        Article 24(1)(a) requires providers to report the share of certified
        out-of-court body decisions they actually implement. Three of four
        platforms report 0% or near-zero; TikTok reports 0.4–40% depending
        on encoding ambiguity. The Appeals Centre Europe reports overturning
        roughly 75% of platform decisions submitted to it.
      </p>
      <a class="more" href="/compare/appeals">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{linkedinLanguages?.value_if_reported ?? 12}/24</p>
      <p class="number-context">LinkedIn — official EU languages with reported moderators</p>
      <h3>LinkedIn doesn't staff half the EU's official languages</h3>
      <p>
        Czech, Danish, Estonian, Greek, Hungarian, Latvian, Romanian, Slovak,
        Slovenian, Swedish, Maltese, and Irish — all reported as zero
        moderators. LinkedIn has 800,000 Greek users and zero Greek-speaking
        moderators.
      </p>
      <a class="more" href="/compare/languages">See the comparison →</a>
    </article>

    <article class="finding">
      <p class="number">{Number(topPerUserActions.per_million_amar / 1000).toFixed(1)}</p>
      <p class="number-context">X — account actions per thousand EU users</p>
      <h3>X enforces 16× more per user than TikTok</h3>
      <p>
        Per thousand users: X 275.8, Instagram 94.6, LinkedIn 66.6, TikTok 17.3.
        After controlling for platform size, X's per-user enforcement rate is
        roughly 16× higher than TikTok's, even though TikTok has more total
        actions in absolute terms.
      </p>
      <a class="more" href="/compare/headlines">See the comparison →</a>
    </article>
  </section>
</Layout>

<style>
  .amar-footnote { font-size: 0.9rem; color: var(--ink-faint); margin-top: 1rem; margin-bottom: 2rem; }

  .findings { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2rem; }
  @media (min-width: 768px) {
    .findings { grid-template-columns: 1fr 1fr; }
    .findings .hero { grid-column: 1 / -1; }
  }

  .finding {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .finding .number {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.25rem;
    color: var(--ink);
  }
  .finding .number-context {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }
  .finding h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem !important;
  }
  .finding p { font-size: 0.95rem; margin: 0; }
  .finding .more {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
  }
</style>