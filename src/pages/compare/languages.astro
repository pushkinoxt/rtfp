---
// src/pages/compare/languages.astro
// Cross-platform comparison of human-moderator language coverage (Article 42).
// Surfaces the specific EU official languages each platform leaves unstaffed.

import Layout from "../../layouts/Layout.astro";
import { fetchFromSupabase } from "../../lib/supabase.js";

const MARKETPLACE_SLUGS = new Set(["amazon-store", "zalando", "aliexpress", "shein", "temu"]);
const typeOf = (slug) => MARKETPLACE_SLUGS.has(slug) ? "marketplace" : "social";

// The EU's 24 official languages — the canonical set we measure coverage against.
const EU_OFFICIAL = [
  "Bulgarian", "Croatian", "Czech", "Danish", "Dutch", "English", "Estonian",
  "Finnish", "French", "German", "Greek", "Hungarian", "Irish", "Italian",
  "Latvian", "Lithuanian", "Maltese", "Polish", "Portuguese", "Romanian",
  "Slovak", "Slovenian", "Spanish", "Swedish",
];
const EU_TOTAL = EU_OFFICIAL.length; // 24

const rows = await fetchFromSupabase("human_moderators_by_language", {
  select: "provider_slug,provider_name,language_code,language_name,is_eu_official,moderators",
});

const byProvider = new Map();
for (const r of rows) {
  const slug = r.provider_slug;
  if (!byProvider.has(slug)) {
    byProvider.set(slug, {
      slug, name: r.provider_name, type: typeOf(slug),
      totalModerators: null,
      covered: new Set(),
    });
  }
  const p = byProvider.get(slug);
  const isTotal = String(r.language_code).toLowerCase() === "total";
  if (isTotal) {
    p.totalModerators = r.moderators != null ? Number(r.moderators) : p.totalModerators;
  } else if (r.is_eu_official === true && Number(r.moderators ?? 0) > 0) {
    p.covered.add(r.language_name);
  }
}

const providers = [...byProvider.values()].map(p => {
  const missing = EU_OFFICIAL.filter(l => !p.covered.has(l));
  return {
    slug: p.slug, name: p.name, type: p.type,
    totalModerators: p.totalModerators,
    coveredCount: EU_TOTAL - missing.length,
    missing,
  };
});

// Coverage ranking: most languages covered first.
const coverage = [...providers].sort((a, b) => b.coveredCount - a.coveredCount);

// Headcount ranking: most moderators first (where reported).
const headcount = providers
  .filter(p => p.totalModerators != null)
  .sort((a, b) => b.totalModerators - a.totalModerators);

const fmt = (n) => n == null ? "—" : Number(n).toLocaleString("en-GB");
const pctOf = (v, max) => `${(v / Math.max(1, max) * 100).toFixed(1)}%`;
const maxHead = Math.max(1, ...headcount.map(r => r.totalModerators));

const title = "Compare: language coverage — RTFP";
const description = "Which of the EU's 24 official languages each platform staffs content moderators for — and which they leave unstaffed.";
---

<Layout title={title} description={description}>
  <p class="breadcrumb"><a href="/">← Findings</a></p>
  <h2>Language coverage, compared</h2>
  <p>
    Under Article 42, platforms report the human moderators they allocate per
    language. The EU has 24 official languages. Below is how many each platform
    fields — and, for each, exactly which official languages it reports
    <em>no</em> moderators for. Note that not every platform operates in every 
    Member State. A platform may report no moderators for a language 
    because it has little or no presence in that market, not necessarily because 
    of a staffing gap. The data presented reflects what was reported, not a judgment 
    about adequacy.
  </p>

  <div class="legend">
    <span class="legend-item"><span class="swatch swatch-social"></span> Social platform</span>
    <span class="legend-item"><span class="swatch swatch-marketplace"></span> Marketplace</span>
  </div>

  <section class="metric">
    <h3>Coverage of the 24 EU official languages</h3>
    <p class="blurb">Each platform's covered count, with the unstaffed languages listed beneath. A language counts as covered if the platform reports one or more moderators for it.</p>

    <div class="coverage-list">
      {coverage.map(p => (
        <div class="coverage-row">
          <div class="coverage-head">
            <a class="cov-name" href={`/data/${p.slug}`}>{p.name}</a>
            <span class="bar-track">
              <span class={`bar-fill ${p.type === "marketplace" ? "fill-marketplace" : "fill-social"}`} style={`width: ${pctOf(p.coveredCount, EU_TOTAL)}`}></span>
            </span>
            <span class="cov-count">{p.coveredCount}/{EU_TOTAL}</span>
          </div>
          {p.missing.length > 0 ? (
            <p class="missing"><span class="missing-label">Unstaffed:</span> {p.missing.join(", ")}</p>
          ) : (
            <p class="missing all-covered">All 24 official languages staffed.</p>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="metric">
    <h3>Total content moderators reported</h3>
    <p class="blurb">Each platform's reported total headcount of human moderators. Larger absolute numbers don't necessarily mean broader language coverage.</p>
    <div class="bar-chart">
      {headcount.map(r => (
        <div class="bar-row">
          <a class="bar-label" href={`/data/${r.slug}`} title={r.name}>{r.name}</a>
          <span class="bar-track">
            <span class={`bar-fill ${r.type === "marketplace" ? "fill-marketplace" : "fill-social"}`} style={`width: ${pctOf(r.totalModerators, maxHead)}`}></span>
          </span>
          <span class="bar-value">{fmt(r.totalModerators)}</span>
        </div>
      ))}
    </div>
  </section>

  <p class="footnote">
    Figures as filed for H2 2025. A language counts as staffed if the platform reports one or more moderators for it; "unstaffed" means a reported figure of zero or no figure at all. Source filings on <a href="/sources">Sources</a>; data via the <a href="/api">API</a>.
  </p>

  <script type="application/json" id="rtfp-languages-data" set:html={JSON.stringify({ providers, euOfficial: EU_OFFICIAL })}></script>
</Layout>

<style>
  .breadcrumb { font-size: 0.85rem; margin-bottom: 1rem; }
  .legend { display: flex; gap: 1.5rem; font-size: 0.85rem; color: var(--ink-dim); margin: 0 0 1.5rem; }
  .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
  .swatch { width: 0.9rem; height: 0.9rem; border-radius: 2px; display: inline-block; }
  .swatch-social { background: var(--ink); }
  .swatch-marketplace { background: var(--ink-faint); }
  .metric { margin: 0 0 3rem; }
  .metric h3 { margin-bottom: 0.25rem; }
  .blurb { font-size: 0.9rem; margin: 0 0 1.25rem; }

  /* Coverage list: each provider gets a bar plus the unstaffed-language list. */
  .coverage-list { display: flex; flex-direction: column; gap: 1.1rem; }
  .coverage-row { }
  .coverage-head { display: grid; grid-template-columns: 9rem 1fr auto; align-items: center; gap: 0.75rem; font-size: 0.85rem; }
  @media (max-width: 600px) { .coverage-head { grid-template-columns: 6.5rem 1fr auto; } }
  .cov-name { color: var(--ink); text-decoration: none; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cov-name:hover { text-decoration: underline; }
  .cov-count { font-variant-numeric: tabular-nums; color: var(--ink-dim); min-width: 3rem; text-align: right; }
  .missing { font-size: 0.8rem; color: var(--ink-faint); margin: 0.35rem 0 0 0; padding-left: 9.75rem; line-height: 1.4; }
  @media (max-width: 600px) { .missing { padding-left: 0; } }
  .missing-label { color: var(--ink-dim); font-weight: 500; }
  .missing.all-covered { font-style: italic; }

  .bar-chart { display: flex; flex-direction: column; gap: 0.45rem; }
  .bar-row { display: grid; grid-template-columns: 9rem 1fr auto; align-items: center; gap: 0.75rem; font-size: 0.85rem; }
  @media (max-width: 600px) { .bar-row { grid-template-columns: 7rem 1fr auto; } }
  .bar-label { color: var(--ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  a.bar-label:hover { text-decoration: underline; }
  .bar-track { background: #f0efed; border-radius: 3px; height: 1.15rem; overflow: hidden; }
  .bar-fill { display: block; height: 100%; border-radius: 3px; min-width: 2px; }
  .fill-social { background: var(--ink); }
  .fill-marketplace { background: var(--ink-faint); }
  .bar-value { font-variant-numeric: tabular-nums; color: var(--ink-dim); min-width: 4rem; text-align: right; }
  .footnote { font-size: 0.8rem; color: var(--ink-faint); margin-top: 2rem; }
</style>