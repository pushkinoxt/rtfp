---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import { fetchFromSupabase } from "../lib/supabase.js";

const providers = await fetchFromSupabase("provider_overview", {
  select: "provider_slug,provider_name",
  order: "provider_name.asc",
});

// De-duplicate (provider_overview is one row per filing).
const seen = new Set();
const unique = [];
for (const p of providers) {
  if (seen.has(p.provider_slug)) continue;
  seen.add(p.provider_slug);
  unique.push(p);
}

const MARKETPLACE_SLUGS = new Set([
  "amazon-store", "zalando", "aliexpress", "shein", "temu",
]);
const marketplaces = unique.filter(p => MARKETPLACE_SLUGS.has(p.provider_slug));
const social = unique.filter(p => !MARKETPLACE_SLUGS.has(p.provider_slug));

const providerCount = unique.length;

// "A, B and C" from a list of names.
function nameList(items) {
  const names = items.map(p => p.provider_name);
  if (names.length <= 1) return names[0] ?? "";
  return `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]}`;
}

const socialNames = nameList(social);
const marketplaceNames = nameList(marketplaces);
---

<Layout title="About — RTFP" description="What RTFP is, what it isn't, and how the numbers reconcile against the providers' own filings.">
  <h2>About</h2>
  <p>
    RTFP is a cross-platform comparison of the largest platforms'
    EU Digital Services Act transparency reports. We load the
    platforms' published filings into a normalised database and expose
    the comparisons that no individual provider reports themselves.
  </p>

  <h3>Why now</h3>
  <p>
    The DSA has required VLOPs (and VLOSEs) to publish transparency
    reports twice a year since August 2023. For the first two years, every
    platform reported in its own format. Comparison was nearly impossible.
    From the H2 2025 reporting cycle (published February 2026), all platforms
    must use the harmonised template defined by Commission Implementing
    Regulation 2024/2835. This is the first time the data can be
    compared directly.
  </p>

  <h3>What's covered</h3>
  <p>
    The dataset currently covers the H2 2025 filings of {providerCount}
    platforms{social.length > 0 && marketplaces.length > 0 ? ", across two groups" : ""}.
  </p>
  {social.length > 0 && (
    <p>
      <strong>Social platforms:</strong> {socialNames}.
    </p>
  )}
  {marketplaces.length > 0 && (
    <p>
      <strong>Marketplaces:</strong> {marketplaceNames}.
    </p>
  )}
  <p>
    The dataset will grow over time as new reports are filed.  This is currently in a trial phase, and we 
    continue to work on growing the dataset to include the filings of all the 
    largest platforms. Also, the next reporting cycle covering H1 2026 is due in 
    August 2026, and any amendments to past filings will also be added as soon as we can.
    Please note that the "social platforms" and "marketplaces" terminology are our own, 
    based on general usage.
  </p>

  <h3>What this is not</h3>
  <p>
    This is not an audit. Every number on the site is what each
    platform self-reported. Where platforms disagree on methodology — and they
    do — that's surfaced as a finding only. Remember, garbage in, garbage out.
  </p>
  <p>
    This site does not include data from the EU's Statements of Reasons
    database (which is a separate dataset covering individual moderation
    decisions). It covers only the quantitative templates filed under Articles
    15 and 24 of the DSA, and the qualitative narrative sections under Article 42.
  </p>

  <h3>How the numbers reconcile</h3>
  <p>
    Each finding on the site links to the underlying database view. Every view
    is publicly queryable via the <a href="/api">REST API</a>. Every filing the
    site draws from is linked on the <a href="/sources">Sources</a> page so the
    numbers can be checked against the providers' own published reports.
  </p>

  <h3>Who built this</h3>
  <p>
    RTFP is built by Oscar (<a href="https://github.com/pushkinoxt">@pushkinoxt</a>) and Sune (at).
  </p>
</Layout>