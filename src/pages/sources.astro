---
// src/pages/sources.astro
import Layout from "../layouts/Layout.astro";
import { fetchFromSupabase } from "../lib/supabase.js";

const [allFilings, overview] = await Promise.all([
  fetchFromSupabase("filings_overview", {
    select: "provider_slug,provider_name,period_label,original_published_on,this_version_published_on,version_number,report_url,filing_slug",
    order: "provider_name.asc,version_number.asc",
  }),
  fetchFromSupabase("provider_overview", {
    select: "provider_slug,service_category",
  }),
]);

// slug -> service_category, used to flag adult-content destinations.
const categoryBySlug = Object.fromEntries(
  overview.map((p) => [p.provider_slug, p.service_category])
);

// Drop the separate advertising-service filings (slug suffix /ads): they share
// the provider's main report URL, so listing them as their own source entry is
// redundant. The original and restated versions of a filing are both kept.
const filings = allFilings.filter((f) => !(f.filing_slug || "").endsWith("/ads"));

const fmtDate = (d) => d ? new Date(d).toLocaleDateString("en-GB", {
  year: "numeric", month: "long", day: "numeric"
}) : "—";

const downloadsAFile = (url) => /\.(zip|xls|xlsx)$/i.test(url || "");
const isAdult = (slug) => categoryBySlug[slug] === "Adult content";
---

<Layout title="Sources | RTFP" description="Source filings for every number on RTFP, linked to the providers' own published reports.">
  <h2>Sources</h2>
  <p>
    Every number on RTFP is drawn from the providers' own published H2 2025
    transparency filings under the Digital Services Act. Each filing is linked
    below in its canonical location on the provider's own website.
  </p>
  <p>
    Every platform here is a Very Large Online Platform (VLOP) designated by the
    European Commission. The Commission maintains the official, authoritative
    register of designated VLOPs and VLOSEs, which is the canonical reference
    for who is in scope:
    <a href="https://digital-strategy.ec.europa.eu/en/policies/list-designated-vlops-and-vloses" rel="noopener noreferrer">the
    Commission's designated-platforms list</a>.
  </p>

  {filings.map((f) => (
    <article class="filing">
      <h3>
        {f.provider_name}
        {f.version_number > 1 && <span class="badge">Restated</span>}
      </h3>
      <p class="meta">
        <strong>Period:</strong> {f.period_label} ·
        <strong>Originally published:</strong> {fmtDate(f.original_published_on)} ·
        <strong>This version:</strong> {fmtDate(f.this_version_published_on)} ·
        <strong>Version:</strong> {f.version_number}
      </p>
      <p class="links">
        <a href={`/platforms/${f.provider_slug}`}>View RTFP data →</a>
        {f.report_url && (
          <span class="ext">
            <a href={f.report_url} rel="noopener noreferrer">Provider's original filing →</a>
            {downloadsAFile(f.report_url) && <span class="note">(downloads a file)</span>}
            {isAdult(f.provider_slug) && <span class="warn">(adult-content site)</span>}
          </span>
        )}
      </p>
    </article>
  ))}

  <slot name="footer" slot="footer">
    <p>If a number on RTFP doesn't match what's in a provider's filing, the provider's filing wins. Please let us know. We'll correct it.</p>
  </slot>
</Layout>

<style>
  .filing {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }
  .filing h3 { margin: 0 0 0.5rem !important; font-size: 1.2rem; }
  .filing .badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-faint);
    border: 1px solid var(--border);
    border-radius: 999px;
    vertical-align: middle;
  }
  .filing .meta { font-size: 0.9rem; margin: 0 0 0.5rem; }
  .filing .meta strong { color: var(--ink); font-weight: 500; }
  .filing .links { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 0; font-size: 0.9rem; align-items: baseline; }
  .filing .ext { display: inline-flex; gap: 0.5rem; flex-wrap: wrap; align-items: baseline; }
  .filing .note { color: var(--ink-faint); font-size: 0.8rem; }
  .filing .warn { color: var(--ink-faint); font-size: 0.8rem; }
</style>