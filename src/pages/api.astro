---
// src/pages/api.astro
import Layout from "../layouts/Layout.astro";

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

const apiUrl = (path) =>
  `${SUPABASE_URL}/rest/v1/${path}${path.includes('?') ? '&' : '?'}apikey=${SUPABASE_KEY}`;

const sections = [
  {
    title: "Reference tables",
    intro: "Small lookup tables joined into most views, useful for understanding country and language coverage.",
    endpoints: [
      { name: "country_codes", description: "30 rows: EU27 plus Iceland, Liechtenstein, Norway. Uses EU convention (EL for Greece, not GR, or IE for Ireland, not GA).", example: "country_codes" },
      { name: "language_codes", description: "24 rows: the official EU languages per Article 55 TFEU.", example: "language_codes" },
    ],
  },
  {
    title: "Foundational",
    endpoints: [
      { name: "amar_by_country", description: "Average Monthly Active Recipients per Member State per provider, per Article 42(3) DSA. The headline platform-size metric.", example: "amar_by_country?country_code=eq.de", exampleNote: "Germany comparison" },
      { name: "provider_overview", description: "One row per (provider × filing). Provider metadata, filing dates, EU total AMAR.", example: "provider_overview" },
    ],
  },
  {
    title: "Government orders (Article 15(1)(a) DSA)",
    endpoints: [
      { name: "government_orders_by_country", description: "Orders from Member State authorities, by country, totals across categories. Article 9 (act against illegal content) and Article 10 (provide information) reported separately.", example: "government_orders_by_country?country_code=eq.fr", exampleNote: "France comparison" },
      { name: "government_orders_by_category", description: "Orders by content category (terrorism, hate speech, etc.), summed across Member States.", example: "government_orders_by_category?provider_slug=eq.tiktok&order=orders_act_received.desc.nullslast&limit=10" },
      { name: "government_orders_summary", description: "Grand totals per provider, with median response times.", example: "government_orders_summary" },
    ],
  },
  {
    title: "Article 16 notices and Trusted Flaggers (Articles 15(1)(b) and 22 DSA)",
    endpoints: [
      { name: "notices_by_category", description: "User notices submitted under the Article 16 mechanism, with the Trusted Flagger breakdown alongside.", example: "notices_by_category?provider_slug=eq.x&order=notices_received.desc.nullslast&limit=10" },
      { name: "trusted_flagger_intensity", description: "Share of notices coming from Trusted Flaggers (civil society organisations with privileged channels), per category.", example: "trusted_flagger_intensity?category_code=eq.TOTAL", exampleNote: "headline per-provider share" },
      { name: "notice_response_times", description: "Median time to action notices, regular vs Trusted Flagger separately.", example: "notice_response_times?category_code=eq.TOTAL" },
    ],
  },
  {
    title: "Own-initiative moderation (Articles 15(1)(c) and 15(1)(d) DSA)",
    endpoints: [
      { name: "moderation_volume_comparison", description: "All own-initiative moderation actions, with a basis column distinguishing illegal-content from ToS-violation enforcement, and a level column for granularity. Filter on level to avoid double-counting.", example: "moderation_volume_comparison?level=eq.total" },
      { name: "automation_share_by_provider", description: "Percentage of moderation taken solely by automated means, per provider and basis.", example: "automation_share_by_provider" },
      { name: "automated_means_accuracy", description: "Reported accuracy, precision and recall of automated content moderation, one row per (provider × metric × scope). Heterogeneous and NOT comparable across providers. Context shows the tool or methodology note verbatim.", example: "automated_means_accuracy?metric=eq.Accuracy" },
      { name: "restriction_type_breakdown", description: "Actions aggregated into the four Annex II families: visibility, monetary, service, account.", example: "restriction_type_breakdown" },
      { name: "account_actions_summary", description: "Account suspensions and terminations per provider per basis.", example: "account_actions_summary?order=total_account_actions.desc.nullslast" },
    ],
  },
  {
    title: "Advertising services (filed separately by Google)",
    intro: "Google files advertising moderation as separate services (YouTube Ads, Google Play Ads, Google Maps Ads, plus Google Shopping's appeals-only sidecar). Held apart from the headline per-provider figures so a platform is never blended with its advertising business.",
    endpoints: [
      { name: "ad_services", description: "Own-initiative ToS moderation volume on each advertising service, with automation share. Only Google reports advertising separately.", example: "ad_services" },
      { name: "ad_service_appeals", description: "Appeals and recidivism figures for advertising services (the only place Google Shopping's ad data appears).", example: "ad_service_appeals" },
      { name: "ad_service_automation", description: "Automated-means volumes and per-tool accuracy for advertising services. Accuracy fractions re-parsed for decimal-comma reporting.", example: "ad_service_automation" },
    ],
  },
  {
    title: "Appeals, disputes, misuse (Articles 20, 21, 23 DSA)",
    endpoints: [
      { name: "internal_complaints_summary", description: "User complaints filed via the Article 20 internal mechanism, by what was originally moderated, with reversal and upheld outcomes.", example: "internal_complaints_summary?complaint_subject=eq.Number%20of%20complaints%20submitted%20to%20the%20internal-complaints%20mechanism" },
      { name: "out_of_court_disputes", description: "Article 21 disputes to certified out-of-court bodies, including share_provider_implemented_pct (the Article 24(1)(a) implementation rate).", example: "out_of_court_disputes" },
      { name: "misuse_suspensions", description: "Article 23 suspensions for repeat offenders, split three ways per Article 24(1)(b).", example: "misuse_suspensions" },
    ],
  },
  {
    title: "Human resources (Article 42(2)(a) DSA)",
    endpoints: [
      { name: "human_moderators_by_language", description: "Moderator headcount per EU official language per provider.", example: "human_moderators_by_language?language_code=eq.el", exampleNote: "Greek moderators across providers" },
    ],
  },
  {
    title: "Cross-cutting derived metrics",
    intro: "These three views compute comparisons no individual provider reports themselves.",
    endpoints: [
      { name: "actions_per_user", description: "Own-initiative moderation volume divided by EU AMAR, per provider and basis.", example: "actions_per_user?basis=eq.tc" },
      { name: "amar_per_moderator", description: "EU AMAR divided by total human moderators per provider.", example: "amar_per_moderator?order=users_per_moderator.desc.nullslast" },
      { name: "headline_metrics_normalised", description: "Long-format view exposing three absolute-volume metrics with their per-million-AMAR rates alongside.", example: "headline_metrics_normalised?metric_key=eq.account_actions&dimension_key=eq.all&order=per_million_amar.desc.nullslast" },
    ],
  },
  {
    title: "Data quality and disclosure transparency",
    endpoints: [
      { name: "filings_overview", description: "One row per filing event with row-count summaries per source table.", example: "filings_overview" },
      { name: "anomalies_by_filing", description: "Methodology and data-quality observations recorded during import.", example: "anomalies_by_filing" },
      { name: "disclosure_coverage", description: "For each (provider × mandated disclosure) tuple, whether the provider populated it. Filter on is_reported=eq.false to see what's missing.", example: "disclosure_coverage?is_reported=eq.false" },
      { name: "platform_notes", description: "Every contextual note a provider attached to its own figures across the filing, surfaced verbatim.", example: "platform_notes?provider_slug=eq.google-maps" },
      { name: "provider_caveats", description: "RTFP-authored comparability notes and known data gaps per provider (RTFP's own observations, not the provider's).", example: "provider_caveats" },
    ],
  },
];
---

<Layout title="API | RTFP" description="Public REST API documentation for RTFP. 30 read-only endpoints covering DSA transparency filings.">
  <h2>API</h2>
  <p>
    The RTFP database is publicly queryable via a REST API. All URLs below return JSON. The credential
    is a publishable key, designed to be shared openly.
  </p>

  <h3>How to use this</h3>
  <p>
    Each URL returns JSON. In most modern browsers JSON is shown directly. Some
    setups benefit from a JSON Viewer browser extension to make it more readable.
  </p>
  <p>
    Basic filtering syntax (PostgREST): append <code>?column=operator.value</code>
    to any URL. Common operators are <code>eq</code> (equals), <code>gt</code>,
    <code>gte</code>, <code>lt</code>, <code>lte</code>, <code>like</code>
    (pattern match), and <code>in</code> (set membership). Sort with
    <code>order=column.desc.nullslast</code>. Limit with <code>limit=N</code>.
    Pick columns with <code>select=col1,col2,col3</code>. Combine with <code>&amp;</code>.
  </p>
  <p>Worked example. Show the top 5 categories by notices received for X:</p>
  <pre><code>?select=category_code,notices_received&provider_slug=eq.x&order=notices_received.desc.nullslast&limit=5</code></pre>
  <p>
    Full PostgREST query reference:
    <a href="https://postgrest.org/en/stable/api.html">postgrest.org</a>.
  </p>

  {sections.map((section) => (
    <section>
      <h3>{section.title}</h3>
      {section.intro && <p>{section.intro}</p>}
      {section.endpoints.map((endpoint) => (
        <div class="endpoint">
          <p><span class="name">{endpoint.name}</span></p>
          <p class="desc">{endpoint.description}</p>
          <p>
            <a class="example-link" href={apiUrl(endpoint.example)} target="_blank" rel="noopener noreferrer">/{endpoint.example} →</a>
            {endpoint.exampleNote && <span class="note"> ({endpoint.exampleNote})</span>}
          </p>
        </div>
      ))}
    </section>
  ))}

  <h3>Total exposed surface</h3>
  <p>
    27 views plus 3 tables, 30 endpoints in total. All read-only.
    Rate-limited at the Supabase free tier (60 requests per minute per anon
    user). OK for human exploration but won't survive scripted scraping.
  </p>
</Layout>

<style>
  .endpoint {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .endpoint:last-child { border-bottom: none; }
  .endpoint .name {
    display: inline-block;
    font-family: ui-monospace, "SF Mono", Menlo, Monaco, monospace;
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--code-bg);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    color: var(--ink);
  }
  .endpoint p { margin: 0.4rem 0; }
  .endpoint .example-link {
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    word-break: break-all;
  }
  .endpoint .note { color: var(--ink-faint); font-size: 0.85rem; }
</style>