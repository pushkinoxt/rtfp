---
// src/pages/test-data.astro
// Throwaway test page to verify the Supabase wiring works.
// Will be deleted before week 3.

import { fetchFromSupabase } from "../lib/supabase.js";

const providers = await fetchFromSupabase("provider_overview", {
  select: "provider_name,amar_eu_total",
  order: "amar_eu_total.desc.nullslast",
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>RTFP — data test</title>
    <style>
      body { font-family: system-ui, sans-serif; padding: 2rem; }
      table { border-collapse: collapse; }
      th, td { border: 1px solid #ddd; padding: 0.5rem 1rem; text-align: left; }
      th { background: #f5f5f4; }
    </style>
  </head>
  <body>
    <h1>Data test</h1>
    <p>If this table shows four providers with AMAR numbers, the data pipeline works.</p>
    <table>
      <thead>
        <tr>
          <th>Provider</th>
          <th>EU AMAR</th>
        </tr>
      </thead>
      <tbody>
        {providers.map((p) => (
          <tr>
            <td>{p.provider_name}</td>
            <td>{p.amar_eu_total.toLocaleString()}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </body>
</html>