---
// src/components/AutomationShare.astro
// Dot plot of the solely-automated share of own-initiative actions, per platform.
// Wired to automation_share_by_provider at build time. Neutral by default
// (alphabetical); the visitor can opt into sorting by share. A basis toggle
// appears only if the view holds more than one basis (illegal, ToS, ...).

import { fetchFromSupabase } from "../lib/supabase.js";

const raw = await fetchFromSupabase("automation_share_by_provider", {
  select: "provider_slug,provider_name,period_label,basis,measures_total,measures_solely_automated,automation_share_pct",
});
const overview = await fetchFromSupabase("provider_overview", { select: "provider_slug,service_category" });
const sectorBySlug = new Map(overview.map((p) => [p.provider_slug, p.service_category || "Other"]));

const toNum = (v) => {
  if (v === null || v === undefined || v === "null" || v === "") return null;
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
};

const BASIS_LABEL = { illegal: "Illegal content", tos: "Terms of service", terms: "Terms of service", total: "All own-initiative", all: "All own-initiative" };
const basisLabel = (b) => BASIS_LABEL[b] || (b ? b.charAt(0).toUpperCase() + b.slice(1) : "Own-initiative");

const bases = [...new Set(raw.map((r) => r.basis).filter(Boolean))];
bases.sort((a, b) => (a === "illegal" ? -1 : b === "illegal" ? 1 : a.localeCompare(b)));
const defaultBasis = bases.includes("illegal") ? "illegal" : bases[0];

// Three honest cases: a real share (dot), reported zero (no share applies), not reported.
function classify(r) {
  const total = toNum(r.measures_total);
  const solely = toNum(r.measures_solely_automated);
  const share = toNum(r.automation_share_pct);
  if (total === null) return { kind: "none" };
  if (total === 0 || share === null) return { kind: "zero" };
  return { kind: "share", share, total, solely };
}

const rows = raw
  .map((r) => ({
    name: r.provider_name,
    basis: r.basis,
    sector: sectorBySlug.get(r.provider_slug) || "Other",
    ...classify(r),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const fmt = (n) => (n == null ? "" : Number(n).toLocaleString("en-GB"));
const detailFor = (r) =>
  r.kind === "share" ? `${r.share}% solely automated (${fmt(r.solely)} of ${fmt(r.total)})`
  : r.kind === "zero" ? "Reported zero own-initiative actions, so no share applies"
  : "No figures presented for this basis";
const valFor = (r) => (r.kind === "share" ? `${Math.round(r.share)}%` : "");
const markerFor = (r) => (r.kind === "zero" ? "reported 0 actions" : r.kind === "none" ? "not reported" : "");

const sectorCounts = {};
for (const r of rows) if (r.basis === defaultBasis) sectorCounts[r.sector] = (sectorCounts[r.sector] || 0) + 1;
const sectors = Object.keys(sectorCounts).sort((a, b) => sectorCounts[b] - sectorCounts[a]);
const defaultCount = rows.filter((r) => r.basis === defaultBasis).length;
---

<div class="autoshare" data-default-basis={defaultBasis}>
  <p class="eyebrow">Automation share</p>
  <h1>Moderation taken by machine alone</h1>
  <p class="standfirst">
    Among the platforms that report it, this is the share of own-initiative moderation actions taken
    by solely automated means rather than by people. A high share is not better or worse, and
    platforms count differently, so the figures sit side by side but are not strictly comparable.
  </p>

  {bases.length > 1 && (
    <div class="bases" id="bases">
      {bases.map((b) => (
        <button data-basis={b} aria-pressed={b === defaultBasis ? "true" : "false"}>{basisLabel(b)}</button>
      ))}
    </div>
  )}

  <div class="sectors" id="sectors">
    <button data-sec="All sectors" aria-pressed="true">All sectors <span class="ct">{defaultCount}</span></button>
    {sectors.map((s) => (
      <button data-sec={s} aria-pressed="false">{s} <span class="ct">{sectorCounts[s]}</span></button>
    ))}
  </div>

  <div class="controls">
    <label class="sortby"><input type="checkbox" id="sortShare" /> Sort by share</label>
  </div>

  <div class="dp-list" id="dplist">
    <div class="dp-row dp-axis" aria-hidden="true">
      <div class="dp-label"></div>
      <div class="dp-track scale">
        <span style="left:0">0%</span>
        <span style="left:25%">25</span>
        <span style="left:50%">50</span>
        <span style="left:75%">75</span>
        <span style="left:100%">100%</span>
      </div>
      <div class="dp-val"></div>
    </div>

    {rows.map((r) => (
      <div
        class="dp-row data"
        data-basis={r.basis}
        data-sector={r.sector}
        data-name={r.name}
        data-blabel={basisLabel(r.basis)}
        data-has={r.kind === "share" ? "1" : "0"}
        data-share={r.kind === "share" ? r.share : ""}
        data-detail={detailFor(r)}
        style={r.basis === defaultBasis ? "" : "display:none"}
      >
        <div class="dp-label">{r.name}</div>
        <div class="dp-track">
          {r.kind === "share"
            ? <span class="dp-dot" style={`left:${r.share}%`}></span>
            : <span class="dp-empty">{markerFor(r)}</span>}
        </div>
        <div class="dp-val">{valFor(r)}</div>
      </div>
    ))}
  </div>

  <p class="source">
    Source: RTFP, from the platforms' H2 2025 DSA transparency filings, Articles 15(1)(c) and
    15(1)(d). Share is solely-automated measures divided by total own-initiative measures. A platform
    that reported zero actions has no share to show, and one that presented no figures is marked not
    reported. Definitions of automated detection vary, so read side-by-side figures with care.
  </p>

  <div class="tip" id="tip"></div>
</div>

<style>
  .autoshare .eyebrow { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 0.6rem; }
  .autoshare h1 { font-size: 1.7rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.5rem; max-width: 38ch; }
  .autoshare .standfirst { font-size: 1rem; color: var(--ink-dim); margin: 0 0 0.4rem; max-width: 66ch; }

  .autoshare .bases, .autoshare .sectors { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .autoshare .bases { margin: 1rem 0 0.55rem; }
  .autoshare .sectors { margin: 0 0 0.55rem; }
  .autoshare .bases button, .autoshare .sectors button { font: inherit; font-size: 0.8rem; color: var(--ink-dim); background: none; border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.75rem; cursor: pointer; transition: border-color 0.15s, color 0.15s, background 0.15s; }
  .autoshare .sectors button .ct { color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .autoshare .bases button:hover, .autoshare .sectors button:hover { color: var(--ink); border-color: var(--ink-faint); }
  .autoshare .bases button[aria-pressed="true"], .autoshare .sectors button[aria-pressed="true"] { color: var(--bg); background: var(--ink); border-color: var(--ink); }
  .autoshare .sectors button[aria-pressed="true"] .ct { color: #d6d3d1; }

  .autoshare .controls { margin: 0.3rem 0 0.4rem; }
  .autoshare .sortby { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--ink-dim); cursor: pointer; }
  .autoshare .sortby input { cursor: pointer; }

  .autoshare .dp-list { margin-top: 1.5rem; }
  .autoshare .dp-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.16rem 0; }
  .autoshare .dp-label { width: 10rem; flex: none; font-size: 0.85rem; text-align: right; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .autoshare .dp-track { position: relative; flex: 1; height: 1.4rem; border-left: 1px solid var(--border); background: repeating-linear-gradient(to right, transparent 0, transparent calc(25% - 1px), var(--border) calc(25% - 1px), var(--border) 25%); }
  .autoshare .dp-dot { position: absolute; top: 50%; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--ink); transform: translate(-50%, -50%); }
  .autoshare .dp-empty { position: absolute; left: 0.2rem; top: 50%; transform: translateY(-50%); font-size: 0.76rem; color: var(--ink-faint); }
  .autoshare .dp-val { width: 2.6rem; flex: none; font-size: 0.8rem; color: var(--ink-dim); font-variant-numeric: tabular-nums; text-align: right; }
  .autoshare .dp-row:hover .dp-label { font-weight: 500; }

  .autoshare .dp-axis { height: 1rem; margin-bottom: 0.6rem; }
  .autoshare .dp-axis .dp-track { height: auto; border-left: none; background: none; }
  .autoshare .dp-axis .scale span { position: absolute; top: 0; font-size: 0.7rem; color: var(--ink-faint); transform: translateX(-50%); }
  .autoshare .dp-axis .scale span:first-child { transform: translateX(0); }
  .autoshare .dp-axis .scale span:last-child { transform: translateX(-100%); }

  .autoshare .tip { position: fixed; z-index: 50; pointer-events: none; background: var(--ink); color: #fafaf9; padding: 0.55rem 0.7rem; border-radius: 6px; font-size: 0.78rem; line-height: 1.35; max-width: 18rem; box-shadow: 0 6px 22px rgba(0,0,0,0.18); opacity: 0; transition: opacity 0.1s; }
  .autoshare .tip.show { opacity: 1; }
  .autoshare .tip .t-dim { color: #d6d3d1; font-size: 0.72rem; }
  .autoshare .tip .t-note { margin-top: 0.25rem; }

  .autoshare .source { margin-top: 1.4rem; font-size: 0.78rem; color: var(--ink-faint); max-width: 68ch; line-height: 1.5; }

  @media (max-width: 640px) {
    .autoshare .dp-label { width: 6.5rem; font-size: 0.8rem; }
  }
</style>

<script>
  const root = document.querySelector(".autoshare");
  if (root) {
    const list = root.querySelector("#dplist");
    const rows = Array.from(list.querySelectorAll(".dp-row.data"));
    const tip = root.querySelector("#tip");
    const sectors = root.querySelector("#sectors");
    const bases = root.querySelector("#bases");
    const sortShare = root.querySelector("#sortShare");
    const state = { basis: root.dataset.defaultBasis, sector: "All sectors", sort: false };

    function shareOf(r) { return r.dataset.has === "1" ? parseFloat(r.dataset.share) : -1; }
    function visible(r) {
      return r.dataset.basis === state.basis && (state.sector === "All sectors" || r.dataset.sector === state.sector);
    }

    function updateCounts() {
      const counts = {}; let all = 0;
      rows.forEach((r) => { if (r.dataset.basis === state.basis) { counts[r.dataset.sector] = (counts[r.dataset.sector] || 0) + 1; all++; } });
      sectors.querySelectorAll("button").forEach((b) => {
        const s = b.dataset.sec, ct = b.querySelector(".ct");
        const n = s === "All sectors" ? all : (counts[s] || 0);
        if (ct) ct.textContent = String(n);
        b.style.display = (s !== "All sectors" && n === 0) ? "none" : "";
      });
    }

    function apply() {
      const v = rows.filter(visible).sort((a, b) => {
        if (state.sort) { const d = shareOf(b) - shareOf(a); if (d !== 0) return d; }
        return a.dataset.name.localeCompare(b.dataset.name);
      });
      rows.forEach((r) => (r.style.display = "none"));
      v.forEach((r) => { r.style.display = ""; list.appendChild(r); });
      updateCounts();
    }

    function showTip(r) {
      tip.innerHTML =
        "<div><b>" + r.dataset.name + "</b></div>" +
        "<div class='t-dim'>Automation share · " + r.dataset.blabel + "</div>" +
        "<div class='t-note'>" + r.dataset.detail + "</div>";
      tip.classList.add("show");
    }
    function moveTip(e) {
      let x = e.clientX + 14, y = e.clientY + 14;
      const w = tip.offsetWidth, h = tip.offsetHeight;
      if (x + w > window.innerWidth - 8) x = e.clientX - w - 14;
      if (y + h > window.innerHeight - 8) y = e.clientY - h - 14;
      tip.style.left = x + "px"; tip.style.top = y + "px";
    }
    function hideTip() { tip.classList.remove("show"); }

    list.addEventListener("mouseover", (e) => { const r = e.target.closest(".dp-row.data"); if (r) showTip(r); });
    list.addEventListener("mousemove", (e) => { if (tip.classList.contains("show")) moveTip(e); });
    list.addEventListener("mouseout", (e) => { if (e.target.closest(".dp-row.data")) hideTip(); });

    sectors.addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b) return;
      state.sector = b.dataset.sec;
      sectors.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
      apply();
    });

    if (bases) bases.addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b) return;
      state.basis = b.dataset.basis;
      state.sector = "All sectors";
      bases.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
      sectors.querySelectorAll("button").forEach((x, i) => x.setAttribute("aria-pressed", i === 0 ? "true" : "false"));
      apply();
    });

    sortShare.addEventListener("change", () => { state.sort = sortShare.checked; apply(); });

    apply();
  }
</script>